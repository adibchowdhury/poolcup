# Internal app-to-app auth (e.g. OAuth callback → /api/handle-new-user)
INTERNAL_WEBHOOK_SECRET=

# Cron job auth (Vercel sends Authorization: Bearer <value> on scheduled invocations)
CRON_SECRET=

# Stripe donation webhook (Dashboard → Developers → Webhooks → signing secret)
STRIPE_WEBHOOK_SECRET=

# Coming-soon gate (proxy.ts).
# 'on' = marketing pages public (/ , /pricing, legal, /contact); auth + app rewrite to /coming-soon.
# 'off' or unset = normal full site.
# COMING_SOON_MODE=on
# Secret preview bypass token — visit /?preview=<token> to set a cookie and unlock the real site.
# COMING_SOON_BYPASS_TOKEN=

# Issue report ntfy notifications (defaults: https://ntfy.sh / poolcup-bugs)
# NTFY_SERVER=https://ntfy.sh
# NTFY_TOPIC=poolcup-bugs
# NTFY_AUTH_TOKEN=
