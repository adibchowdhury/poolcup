# Internal app-to-app auth (e.g. OAuth callback → /api/handle-new-user)
INTERNAL_WEBHOOK_SECRET=

# HMAC secret for signed share-card image URLs (?t=…). Prefer a dedicated value;
# runtime falls back to INTERNAL_WEBHOOK_SECRET / CRON_SECRET if unset.
SHARE_TOKEN_SECRET=

# Cron job auth (Vercel sends Authorization: Bearer <value> on scheduled invocations)
CRON_SECRET=

# API-Sports / api-sports.io All-Sports plan key (soccer, baseball, …).
# Sent as x-apisports-key to v3.football and v1.baseball hosts.
API_FOOTBALL_KEY=

# Stripe donation webhook (Dashboard → Developers → Webhooks → signing secret)
STRIPE_WEBHOOK_SECRET=

# Stripe (server-only; never expose secret to the client)
STRIPE_SECRET_KEY=
# One-time Custom Pool upgrade ($9.99)
STRIPE_PRICE_CUSTOM_POOL=
# Custom Pool / billing webhook (separate from donation STRIPE_WEBHOOK_SECRET)
STRIPE_BILLING_WEBHOOK_SECRET=

# Coming-soon gate (proxy.ts).
# 'on' = marketing pages public (/ , /pricing, legal, /contact); auth + app rewrite to /coming-soon.
# 'off' or unset = normal full site.
# COMING_SOON_MODE=on
# Secret preview bypass token — visit /?preview=<token> to set a cookie and unlock the real site.
# COMING_SOON_BYPASS_TOKEN=

# ntfy notifications (defaults: https://ntfy.sh)
# NTFY_SERVER=https://ntfy.sh
# NTFY_AUTH_TOKEN=
# Issue reports → poolcup-bugs
# NTFY_TOPIC=poolcup-bugs
# Ops alerts → poolcup-ops
# NTFY_OPS_TOPIC=poolcup-ops
# Waitlist signups (falls back to NTFY_OPS_TOPIC / poolcup-ops)
# NTFY_WAITLIST_TOPIC=poolcup-ops

# Discord (Pucky bot)
DISCORD_BOT_TOKEN=
DISCORD_CHANNEL_SOCCER=
DISCORD_CHANNEL_FOOTBALL=
DISCORD_CHANNEL_BASKETBALL=
DISCORD_CHANNEL_BASEBALL=
DISCORD_CHANNEL_HOCKEY=
